#: electrumsv/gui/qt/ledger_progress.py
msgid ""
"Cancellation requested. Finish or reject the current request on your Ledger;"
" signing will stop before the next device operation."
msgstr ""
"Đã yêu cầu hủy. Hoàn tất hoặc từ chối yêu cầu hiện tại trên Ledger; việc ký "
"sẽ dừng trước thao tác tiếp theo trên thiết bị."

