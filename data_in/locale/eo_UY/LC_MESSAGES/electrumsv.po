#: electrumsv/devices/ledger/ledger.py
msgid ""
"Cannot open Ledger. Close Ledger Wallet, browser device sessions and other "
"wallet applications, then reconnect, unlock and retry."
msgstr ""
"Ne povas malfermi Ledger. Fermu Ledger Wallet, retumilaparatajn sesiojn kaj "
"aliajn monujojn, poste rekonektu, malŝlosu kaj reprovu."

