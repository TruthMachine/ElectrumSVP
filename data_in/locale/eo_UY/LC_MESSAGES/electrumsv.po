msgstr "Certiĝu, ke ĝi estas en la ĝusta stato."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
msgid ""
"Matches a hardware key in the current account. The complete account public "
