"No devices detected. Connect a hardware wallet; this list updates "
"automatically."
msgstr ""
"Neniuj aparatoj detektitaj. Konekti aparatan monujon; ĉi tiu listo "
"ĝisdatiĝas aŭtomate."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
