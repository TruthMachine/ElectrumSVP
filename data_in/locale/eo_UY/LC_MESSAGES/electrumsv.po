msgstr "Neniuj aparataro detektita"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
msgid "Not detected"
msgstr "Ne detektita"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
msgid ""
"Only checked inputs will receive new signatures. Existing signatures will be"
" kept. Ledger still reviews the whole transaction: each new signature uses "
"SIGHASH_ALL | FORKID (0x41), committing to all inputs and outputs. Save the "
"incomplete transaction as JSON to pass it to another signer."
msgstr ""
"Nur kontrolitaj enigaĵoj ricevos novajn subskribojn. Ekzistantaj subskriboj "
"estos konservitaj. Ledger ankoraŭ revizias la tutan transakcion: ĉiu nova "
"subskribo uzas SIGHASH_ALL | FORKID (0x41), devontigante ĉiujn enigojn kaj "
"elirojn. Konservu la nekompletan transakcion kiel JSON por transdoni ĝin al "
"alia subskribinto."

