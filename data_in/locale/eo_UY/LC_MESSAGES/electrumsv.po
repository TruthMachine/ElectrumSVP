msgstr "Ledger konekto estas fermita. Rekonektu kaj provu denove."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/transport.py
msgid ""
"Ledger did not respond. Finish or reject the request on the device, "
"reconnect it, close other wallet applications and retry."
msgstr ""
"Ledger ne respondis. Finu aŭ malakceptu la peton sur la aparato, rekonektu "
