msgstr "Ledger estas okupata de alia peto. Finu ĝin kaj provu denove."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Ledger is locked. Enter your PIN on the device and retry."
msgstr "Ledger estas ŝlosita. Enigu vian PIN sur la aparato kaj reprovu."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
msgid ""
"Ledger may display only a message hash. Compare it with this SHA-256 of the "
"exact UTF-8 message, including spaces and newlines. The device has not "
"displayed the message text."
msgstr ""
"Ledger povas montri nur mesaĝon hash. Komparu ĝin kun ĉi tiu SHA-256 de la "
"ĝusta UTF-8-mesaĝo, inkluzive de spacoj kaj novlinioj. La aparato ne montris"
" la mesaĝtekston."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/transport.py
msgid "Ledger returned an incomplete response."
msgstr "Ledger resendis nekompletan respondon."

