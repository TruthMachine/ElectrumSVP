# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware_accounts.py
msgid "&Rescan"
msgstr "&Reskanu"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "A complete previous transaction is unavailable."
msgstr "Kompleta antaŭa transakcio ne estas disponebla."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid ""
"A hardware wallet operation is already in progress. Finish or reject it on "
"the device, then try again."
msgstr ""
"Operacio pri aparatara monujo jam okazas. Finu aŭ malakceptu ĝin sur la "
"aparato, tiam provu denove."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware_accounts.py
msgid ""
"A scan has been unable to locate any connected hardware wallets. Connect and"
" unlock your hardware wallet, close other wallet applications, then press "
"the 'Rescan' button to try again."
msgstr ""
"Skanado ne povis trovi iujn ajn konektitajn aparatajn monujojn. Konektu kaj "
"malŝlosu vian aparatan monujon, fermu aliajn monujojn, poste premu la "
"butonon 'Rescan' por provi denove."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
msgid "Account check cancelled. Select the device and retry."
msgstr "Kontkontrolo nuligita. Elektu la aparaton kaj reprovu."

