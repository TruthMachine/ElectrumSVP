#: electrumsv/gui/qt/hardware.py
msgid "Choose inputs to sign"
msgstr "Elektu enigojn por subskribi"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware_accounts.py
msgid ""
"Choose the account derivation path. When reopening an existing account, use "
"its original path: a different account path gives different addresses even "
"on the same device."
msgstr ""
"Elektu la kontan derivvojon. Remalfermante ekzistantan konton, uzu ĝian "
"originan vojon: malsama konta vojo donas malsamajn adresojn eĉ sur la sama "
"aparato."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/gui/qt/hardware.py
msgid "Close"
msgstr "Fermu"

