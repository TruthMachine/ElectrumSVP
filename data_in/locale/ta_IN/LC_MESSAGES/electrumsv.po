# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/device.py
msgid "Install the dependencies and reopen the wallet to sign."
msgstr "சார்புகளை நிறுவி, கையொப்பமிட பணப்பையை மீண்டும் திறக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/device.py
msgid "The connected device does not match this wallet. Select the correct device and passphrase, then retry."
msgstr "இணைக்கப்பட்ட சாதனம் இந்த பணப்பையுடன் பொருந்தவில்லை. சரியான சாதனம் மற்றும் கடவுச்சொற்றொடரைத் தேர்ந்தெடுத்து, மீண்டும் முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/trezor/trezor.py
msgid "Device disconnected. Please reconnect and try again."
msgstr "சாதனம் துண்டிக்கப்பட்டது. மீண்டும் இணைத்து மீண்டும் முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "A hardware wallet operation is already in progress. Finish or reject it on the device, then try again."
msgstr "வன்பொருள் வாலட் செயல்பாடு ஏற்கனவே நடந்து கொண்டிருக்கிறது. சாதனத்தில் முடிக்கவும் அல்லது நிராகரிக்கவும், பிறகு மீண்டும் முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Address display is unavailable for this account."
msgstr "இந்தக் கணக்கிற்கு முகவரிக் காட்சி இல்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Choose an account derivation path."
msgstr "கணக்கு வழித்தோன்றல் பாதையைத் தேர்வு செய்யவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Connect the device, unlock it and refresh. No USB interface was found; this alone does not establish whether it is locked."
msgstr "சாதனத்தை இணைத்து, அதைத் திறந்து புதுப்பிக்கவும். USB இடைமுகம் இல்லை; இது மட்டும் பூட்டப்பட்டுள்ளதா என்பதை நிறுவவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Device attempted to replace an existing signature."
msgstr "சாதனம் ஏற்கனவே உள்ள கையொப்பத்தை மாற்ற முயற்சித்தது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Device did not return an extended public key."
msgstr "சாதனம் நீட்டிக்கப்பட்ட பொது விசையை வழங்கவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Device returned an invalid message signature."
msgstr "சாதனம் தவறான செய்தி கையொப்பத்தை வழங்கியது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Device returned an unexpected input count."
msgstr "சாதனம் எதிர்பாராத உள்ளீட்டு எண்ணிக்கையை வழங்கியது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Device returned an unexpected signature count."
msgstr "சாதனம் எதிர்பாராத கையொப்ப எண்ணிக்கையை வழங்கியது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Enter a message between 1 and 65535 UTF-8 bytes."
msgstr "1 மற்றும் 65535 UTF-8 பைட்டுகளுக்கு இடையே ஒரு செய்தியை உள்ளிடவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Hardware signing requires SIGHASH_ALL | FORKID (0x41)."
msgstr "வன்பொருள் கையொப்பமிடுவதற்கு SIGHASH_ALL | FORKID (0x41) தேவை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Initialize this device with its manufacturer application before importing it. Never enter its recovery seed into ElectrumSVP."
msgstr "இந்த சாதனத்தை இறக்குமதி செய்வதற்கு முன் அதன் உற்பத்தியாளர் பயன்பாட்டுடன் துவக்கவும். அதன் மீட்பு விதையை ஒருபோதும் ElectrumSVP இல் உள்ளிட வேண்டாம்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
#, python-brace-format
msgid "Install the optional {} dependencies."
msgstr "விருப்பமான {0} சார்புகளை நிறுவவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Optional previous-transaction verification is implemented for Ledger only."
msgstr "விருப்பமான முந்தைய பரிவர்த்தனை சரிபார்ப்பு Ledger க்கு மட்டுமே செயல்படுத்தப்படுகிறது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Select a device of the same brand as this hardware account."
msgstr "இந்த வன்பொருள் கணக்கின் அதே பிராண்டின் சாதனத்தைத் தேர்ந்தெடுக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "Selecting individual inputs is implemented for Ledger only."
msgstr "தனிப்பட்ட உள்ளீடுகளைத் தேர்ந்தெடுப்பது Ledger க்கு மட்டுமே செயல்படுத்தப்படுகிறது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "The selected device is unavailable. Refresh and retry."
msgstr "தேர்ந்தெடுக்கப்பட்ட சாதனம் கிடைக்கவில்லை. புதுப்பித்து மீண்டும் முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "This adapter supports BSV mainnet only."
msgstr "இந்த அடாப்டர் BSV மெயின்நெட்டை மட்டுமே ஆதரிக்கிறது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
msgid "This device does not match the current account. Check the selected device, account path and passphrase."
msgstr "இந்தச் சாதனம் நடப்புக் கணக்குடன் பொருந்தவில்லை. தேர்ந்தெடுக்கப்பட்ட சாதனம், கணக்கு பாதை மற்றும் கடவுச்சொற்றொடரைச் சரிபார்க்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hardware.py
#, python-brace-format
msgid "Unknown hardware wallet: {}"
msgstr "அறியப்படாத வன்பொருள் பணப்பை: {0}"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hw_wallet/plugin.py
msgid "USB device found. Import or select its account to verify wallet pairing. Firmware and signing readiness have not been checked."
msgstr "USB சாதனம் கண்டறியப்பட்டது. வாலட் இணைப்பைச் சரிபார்க்க அதன் கணக்கை இறக்குமதி செய்யவும் அல்லது தேர்ந்தெடுக்கவும். நிலைபொருள் மற்றும் கையொப்பம் தயார்நிலை சரிபார்க்கப்படவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/hw_wallet/qt.py
msgid "Hardware wallet connection status"
msgstr "வன்பொருள் வாலட் இணைப்பு நிலை"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/trezor/trezor.py
msgid "Initialize the device with its manufacturer application."
msgstr "சாதனத்தை அதன் உற்பத்தியாளர் பயன்பாட்டுடன் துவக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "A complete previous transaction is unavailable."
msgstr "முழுமையான முந்தைய பரிவர்த்தனை கிடைக்கவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "Input/output count exceeds this model’s verification budget."
msgstr "உள்ளீடு/வெளியீடு எண்ணிக்கை இந்த மாதிரியின் சரிபார்ப்பு பட்ஜெட்டை விட அதிகமாக உள்ளது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "Previous transaction amount does not match the requested input."
msgstr "முந்தைய பரிவர்த்தனை தொகை கோரப்பட்ட உள்ளீட்டுடன் பொருந்தவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "Previous transaction does not match the requested input."
msgstr "முந்தைய பரிவர்த்தனை கோரப்பட்ட உள்ளீட்டுடன் பொருந்தவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "Previous transaction script does not match the requested input."
msgstr "முந்தைய பரிவர்த்தனை ஸ்கிரிப்ட் கோரப்பட்ட உள்ளீட்டுடன் பொருந்தவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "Previous transactions exceed this model’s byte, script or communication budget."
msgstr "முந்தைய பரிவர்த்தனைகள் இந்த மாதிரியின் பைட், ஸ்கிரிப்ட் அல்லது தகவல் தொடர்பு பட்ஜெட்டை விட அதிகமாகும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/input_verification.py
msgid "This app version is outside the trusted-input route."
msgstr "இந்த ஆப்ஸ் பதிப்பு நம்பகமான உள்ளீட்டு வழிக்கு வெளியே உள்ளது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Bitcoin Cash is open. Wallet pairing is checked separately before use."
msgstr "Bitcoin Cash திறக்கப்பட்டுள்ளது. பயன்பாட்டிற்கு முன் வாலட் இணைத்தல் தனித்தனியாக சரிபார்க்கப்பட்டது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Cannot open Ledger. Close Ledger Wallet, browser device sessions and other wallet applications, then reconnect, unlock and retry."
msgstr "Ledger ஐ திறக்க முடியாது. Ledger Wallet, உலாவி சாதன அமர்வுகள் மற்றும் பிற வாலட் பயன்பாடுகளை மூடிவிட்டு, மீண்டும் இணைக்கவும், திறக்கவும் மற்றும் மீண்டும் முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Enter the PIN on this device, then refresh."
msgstr "இந்தச் சாதனத்தில் PIN ஐ உள்ளிட்டு, புதுப்பிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
#, python-brace-format
msgid "Full verification of {} inputs will send {:.1f} KiB of previous transactions to your Ledger. Verification and signing may take several minutes. Keep the device connected and review the transaction on its screen when prompted. Continue with full verification?"
msgstr "{0} உள்ளீடுகளின் முழு சரிபார்ப்பு {1:.1f} KiB முந்தைய பரிவர்த்தனைகளை உங்கள் Ledger க்கு அனுப்பும். சரிபார்ப்பு மற்றும் கையொப்பமிடுவதற்கு பல நிமிடங்கள் ஆகலாம். சாதனத்தை இணைக்கவும், கேட்கும் போது அதன் திரையில் பரிவர்த்தனையை மதிப்பாய்வு செய்யவும். முழு சரிபார்ப்புடன் தொடரவா?"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Ledger is locked. Enter your PIN on the device and retry."
msgstr "Ledger பூட்டப்பட்டுள்ளது. சாதனத்தில் உங்கள் PIN ஐ உள்ளிட்டு மீண்டும் முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
#, python-brace-format
msgid "Open the Bitcoin Cash app on your Ledger (currently: {})."
msgstr "உங்கள் Ledger இல் Bitcoin Cash பயன்பாட்டைத் திறக்கவும் (தற்போது: {0})."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Opening Bitcoin Cash on the selected Ledger. Confirm on the device if requested."
msgstr "தேர்ந்தெடுக்கப்பட்ட Ledger இல் Bitcoin Cash ஐ திறக்கிறது. கோரப்பட்டால் சாதனத்தில் உறுதிப்படுத்தவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Previous-transaction verification was switched off for this signing operation."
msgstr "இந்த கையொப்பமிடும் செயல்பாட்டிற்கு முந்தைய பரிவர்த்தனை சரிபார்ப்பு முடக்கப்பட்டது."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Review the transaction on your Ledger. Input amounts are unverified."
msgstr "உங்கள் Ledger இல் பரிவர்த்தனையை மதிப்பாய்வு செய்யவும். உள்ளீடு தொகைகள் சரிபார்க்கப்படவில்லை."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Review the transaction on your Ledger. Input amounts were checked against previous transactions; chain status and coinbase maturity are checked by the wallet."
msgstr "உங்கள் Ledger இல் பரிவர்த்தனையை மதிப்பாய்வு செய்யவும். முந்தைய பரிவர்த்தனைகளுக்கு எதிராக உள்ளீடு தொகைகள் சரிபார்க்கப்பட்டன; சங்கிலி நிலை மற்றும் காயின்பேஸ் முதிர்வு ஆகியவை பணப்பையால் சரிபார்க்கப்படுகின்றன."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
#, python-brace-format
msgid "Signing input {} of {} on your Ledger..."
msgstr "உங்கள் Ledger இல் {1} இன் {0} உள்ளீடு கையொப்பமிடுகிறது..."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "The Ledger app rejected this message. Check the derivation path and try a shorter message supported by your app version."
msgstr "Ledger பயன்பாடு இந்த செய்தியை நிராகரித்தது. வழித்தோன்றல் பாதையைச் சரிபார்த்து, உங்கள் ஆப்ஸ் பதிப்பால் ஆதரிக்கப்படும் சிறிய செய்தியை முயற்சிக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "The address displayed by the Ledger does not match this wallet. Check the selected device and account."
msgstr "Ledger ஆல் காட்டப்படும் முகவரி இந்த பணப்பையுடன் பொருந்தவில்லை. தேர்ந்தெடுக்கப்பட்ட சாதனம் மற்றும் கணக்கைச் சரிபார்க்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "The device cannot verify input amounts against previous transactions. It may show \"unverified inputs\". Continue with this reduced verification?"
msgstr "முந்தைய பரிவர்த்தனைகளுக்கு எதிராக உள்ளீடு தொகைகளை சாதனத்தால் சரிபார்க்க முடியாது. இது \"unverified inputs\" என்பதைக் காட்டலாம். இந்த குறைக்கப்பட்ட சரிபார்ப்பை தொடரவா?"

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Unlock this device before signing. The wallet can request opening Bitcoin Cash on the selected device; confirm there if asked."
msgstr "கையொப்பமிடுவதற்கு முன் இந்தச் சாதனத்தைத் திறக்கவும். தேர்ந்தெடுக்கப்பட்ட சாதனத்தில் Bitcoin Cash திறக்க வாலட் கோரலாம்; கேட்டால் அங்கே உறுதிப்படுத்தவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
#, python-brace-format
msgid "Verifying input {} of {} on your Ledger..."
msgstr "உங்கள் Ledger இல் {1} இன் {0} உள்ளீட்டைச் சரிபார்க்கிறது..."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/ledger.py
msgid "Verifying previous transactions on your Ledger..."
msgstr "உங்கள் Ledger இல் முந்தைய பரிவர்த்தனைகளைச் சரிபார்க்கிறது..."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/session.py
msgid "The selected Ledger did not reconnect with the expected app. Unlock it, close other wallet applications and select it again."
msgstr "தேர்ந்தெடுக்கப்பட்ட Ledger எதிர்பார்த்த ஆப்ஸுடன் மீண்டும் இணைக்கப்படவில்லை. அதைத் திறந்து, பிற வாலட் பயன்பாடுகளை மூடிவிட்டு, அதை மீண்டும் தேர்ந்தெடுக்கவும்."

# ElectrumSVP hardware flow: machine translation; review welcome.
#: electrumsv/devices/ledger/session.py
